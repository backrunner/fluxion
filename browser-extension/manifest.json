{
  "manifest_version": 3,
  "name": "Fluxion Browser Downloads",
  "version": "0.1.0",
  "description": "将 HTTP 下载交给 Fluxion，按文件大小跳过，并继承下载请求的登录凭据。",
  "minimum_chrome_version": "132",
  "key": "",
  "permissions": ["downloads", "storage", "webRequest", "nativeMessaging", "alarms", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Fluxion", "default_popup": "options.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "incognito": "not_allowed"
}
