{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluxion",
  "version": "0.1.0",
  "identifier": "top.backrunner.fluxion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QUU2RjM4MUU0MjQ5N0EKUldSNlNVSWVPRyt1ZFRCMlhMOGVNUTV0THYzaDVpT2hnb0ZJYllSb3E4SE91RC9ZSm9Ma3IrOUMK",
      "endpoints": [
        "https://assets.fluxion.alkinum.io/updates/stable/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Fluxion",
        "width": 960,
        "height": 620,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
