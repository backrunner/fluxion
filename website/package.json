{
  "name": "fluxion-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build",
    "preview": "svedocs preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:docs": "svedocs check --translations --strict",
    "check:worker": "tsc -p tsconfig.worker.json",
    "test:support": "node --experimental-strip-types --test tests/support-intake.test.ts",
    "preview:worker": "wrangler dev --local --port 48612",
    "check:deploy": "wrangler deploy --dry-run --outdir .svedocs/worker",
    "deploy": "pnpm build && wrangler deploy",
    "check:built": "node scripts/check-built.mjs"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svedocs": "0.2.3",
    "svelte": "^5.55.7",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "svedocs-cli": "0.2.3",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "wrangler": "4.134.0"
  },
  "packageManager": "pnpm@12.3.4"
}
