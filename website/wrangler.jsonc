{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxion-site",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/support",
      "/api/support/"
    ]
  },
  "routes": [
    {
      "pattern": "fluxion.alkinum.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "SUPPORT_ENABLED": "false",
    "ONFIRE_PRODUCT_ID": "",
    "ONFIRE_TICKET_TYPES": "{}"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_RATE_LIMIT",
      "namespace_id": "26101101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
